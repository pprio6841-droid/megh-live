.forge-celebration-card { position: relative; display: flex; flex-direction: column; max-height: calc(100dvh - 48px); overflow: hidden; color-scheme: dark; color: rgb(var(--bolt-ds-textPrimary)); --forge-sweep: linear-gradient(90deg, transparent 0%, #4d9afb 30%, #7fb2f7 50%, #b9d2f5 70%, transparent 100%); }

.forge-celebration-card-body { position: relative; z-index: 1; min-height: 0px; padding: 3rem 2rem 2.5rem; overflow-y: auto; }

.forge-celebration-effects { position: absolute; inset: 0px; z-index: 0; pointer-events: none; }

.forge-celebration-glow { position: absolute; top: -110px; left: 50%; transform: translate(-50%); width: min(560px, 150%); height: 380px; background: radial-gradient(at 50% 40%, rgba(20, 136, 252, 0.16) 0%, rgba(20, 136, 252, 0.05) 42%, transparent 70%); }

.forge-celebration-field { position: absolute; inset: 0px; width: 100%; height: 100%; opacity: 0.9; }

.forge-celebration-auth-bleed { margin-inline: -0.75rem; }

.forge-celebration-lockup { opacity: 0; transform: scale(0.96); filter: blur(4px); }

.forge-celebration-lockup-playing { animation: 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0s 1 normal forwards running forge-celebration-lockup-in; }

@keyframes forge-celebration-lockup-in { 
  100% { opacity: 1; transform: none; filter: none; }
}

.forge-celebration-greet { margin: 0px; letter-spacing: -0.3px; line-height: 1.3; opacity: 0; transform: translateY(5px); color: rgb(var(--bolt-ds-textPrimary)); }

.forge-celebration-greet-playing { animation: 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.25s 1 normal both running forge-celebration-greet-in; }

@keyframes forge-celebration-greet-in { 
  100% { opacity: 1; transform: none; }
}

.forge-celebration-greet-sweep { background-image: var(--forge-sweep),linear-gradient(rgb(var(--bolt-ds-textPrimary)),rgb(var(--bolt-ds-textPrimary))); background-repeat: no-repeat; background-size: 60% 100%, 100% 100%; background-position: 250% 0px, 0px 0px; background-clip: text; color: transparent; animation: 3s linear 0s infinite normal none running forge-celebration-sweep; opacity: 1; transform: none; }

@keyframes forge-celebration-sweep { 
  0% { background-position: -150% 0px, 0px 0px; animation-timing-function: ease-out; }
  33.333% { background-position: 250% 0px, 0px 0px; }
  100% { background-position: 250% 0px, 0px 0px; }
}

.forge-celebration-card-body input:not([type="checkbox"], [type="radio"]) { background-color: rgb(var(--bolt-ds-bgSecondary)); }

.forge-celebration-code-input.forge-celebration-code-input { font-variant-numeric: tabular-nums; text-align: center; letter-spacing: 0.45em; text-indent: 0.45em; }

@media (max-width: 420px) {
  .forge-celebration-card-body { padding: 2rem 1rem 1.5rem; }
}

@media (prefers-reduced-motion: reduce) {
  .forge-celebration-lockup { opacity: 1; transform: none; filter: none; }
  .forge-celebration-greet { opacity: 1; transform: none; }
  .forge-celebration-lockup-playing, .forge-celebration-greet-playing, .forge-celebration-greet-sweep { animation: auto ease 0s 1 normal none running none; }
}

@media (forced-colors: active) {
  .forge-celebration-effects { display: none; }
  .forge-celebration-greet-sweep { background-image: none; color: canvastext; }
}

html, body { font-family: Inter; width: 100%; text-size-adjust: none; touch-action: manipulation; --font-settings: "cv01", "ss03"; font-feature-settings: var(--font-settings); --font-variations: "opsz" auto; font-variation-settings: var(--font-variations); -webkit-font-smoothing: antialiased; }

* { scrollbar-width: thin; scrollbar-color: rgb(var(--bolt-ds-iconSecondary)) transparent; }

html[data-theme="light"] { color-scheme: light; }

html[data-theme="dark"] { color-scheme: dark; }

html[data-app-shell="locked"], html[data-app-shell="locked"] body, html[data-app-shell="locked"] #root { height: 100%; overflow: hidden; overscroll-behavior: none; }

html[data-embedded-auth="true"], html[data-embedded-auth="true"] body, html[data-embedded-auth="true"] #root { background: transparent !important; }

.selection-accent ::selection { background: rgb(var(--bolt-ds-brand)); color: rgb(var(--bolt-ds-textPrimary)); }
