k size-4"></span></div></button><button class="flex items-center justify-center font-medium shrink-0 max-w-full leading-tight focus-visible:outline-2 disabled:op-50 relative disabled:cursor-not-allowed transition-colors focus-visible:shadow-sm bg-transparent [&amp;:hover:where(:not(:disabled))]:bg-bolt-ds-utilHover focus-visible:outline-bolt-ds-brandHover size-7 rounded-lg text-bolt-ds-textTertiary hover:text-bolt-ds-textPrimary min-h-11 min-w-11 media-mouse:min-h-0 media-mouse:min-w-0" type="button" aria-label="More actions" id="radix-_r_70_" aria-haspopup="menu" aria-expanded="false" data-state="closed"><div class=""><span class="i-heroicons:ellipsis-horizontal block size-4"></span></div></button></div><div data-testid="mobile-app-preview-card" class="w-full overflow-hidden rounded-xl border border-bolt-ds-borderSecondary bg-bolt-ds-bgSecondary"><button type="button" aria-label="Open preview" class="block w-full disabled:cursor-not-allowed"><div class="relative aspect-video overflow-hidden bg-bolt-ds-bgTertiary"><img alt="Megh Live Streaming App preview" class="absolute inset-0 w-full h-full object-cover object-top group-hover:scale-[1.15] transition-transform transition-duration-500" src="https://d33wubrfki0l68.cloudfront.net/6ad2085b2a14ee0649d90b89/screenshot_2026-10-16-11-19-58-0000.webp" style="opacity: 1;"></div></button><span class="sr-only" role="status"></span><div class="flex items-center gap-2 px-3 py-2.5 border-t border-bolt-ds-borderSecondary"><div class="flex min-w-0 flex-1 flex-col"><span class="truncate text-sm font-medium text-bolt-ds-textPrimary">Megh Live Streaming App</span><span class="truncate text-xs text-bolt-ds-textSecondary">Version 2</span></div><div class="flex shrink-0 items-center gap-1"><button class="flex items-center justify-center font-medium shrink-0 min-w-0 max-w-full leading-tight focus-visible:outline-2 disabled:op-50 relative disabled:cursor-not-allowed transition-colors focus-visible:shadow-sm bg-transparent [&amp;:hover:whe