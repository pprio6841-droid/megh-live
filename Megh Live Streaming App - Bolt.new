:root { --bg-primary: #0a0a12; --bg-secondary: #12121f; --bg-tertiary: #1a1a2e; }

* { -webkit-tap-highlight-color: transparent; }

html, body { background-color: var(--bg-primary); color: rgb(245, 245, 250); font-family: "Plus Jakarta Sans", system-ui, sans-serif; overscroll-behavior: none; }

body { max-width: 480px; margin: 0px auto; min-height: 100vh; position: relative; box-shadow: rgba(168, 85, 247, 0.08) 0px 0px 80px; }

.font-display { font-family: Sora, system-ui, sans-serif; }

::-webkit-scrollbar { width: 0px; background: transparent; }

.gradient-text { background: linear-gradient(135deg, rgb(192, 132, 252), rgb(244, 114, 182)) text; -webkit-text-fill-color: transparent; }

.glow-purple { box-shadow: rgba(168, 85, 247, 0.35) 0px 0px 24px; }

.glow-pink { box-shadow: rgba(244, 114, 182, 0.35) 0px 0px 24px; }

.glow-soft { box-shadow: rgba(168, 85, 247, 0.15) 0px 0px 40px; }

@keyframes pulse-ring { 
  0% { transform: scale(1); opacity: 0.7; }
  100% { transform: scale(1.8); opacity: 0; }
}

.animate-pulse-ring::before { content: ""; position: absolute; inset: 0px; border-radius: inherit; border: 2px solid; animation: 1.5s ease-out 0s infinite normal none running pulse-ring; }

@keyframes float { 
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-6px); }
}

.animate-float { animation: 3s ease-in-out 0s infinite normal none running float; }

@keyframes shimmer { 
  0% { background-position: -200% center; }
  100% { background-position: 200% center; }
}

.animate-shimmer { background-size: 200% auto; animation: 3s linear 0s infinite normal none running shimmer; }

@keyframes slide-up { 
  0% { transform: translateY(20px); opacity: 0; }
  100% { transform: translateY(0px); opacity: 1; }
}

.animate-slide-up { animation: 0.4s ease-out 0s 1 normal forwards running slide-up; }

@keyframes fade-in { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.animate-fade-in { animation: 0.3s ease-out 0s 1 normal forwards running fade-in; }

@keyframes equalizer { 
  0%, 100% { height: 6px; }
  50% { height: 18px; }
}

.eq-bar { width: 3px; background: linear-gradient(to top, rgb(192, 132, 252), rgb(244, 114, 182)); border-radius: 2px; animation: 0.6s ease-in-out 0s infinite normal none running equalizer; }

.page-enter { animation: 0.25s ease-out 0s 1 normal forwards running fade-in; }

.no-scrollbar::-webkit-scrollbar { display: none; }

.no-scrollbar { scrollbar-width: none; }

.glass { background: rgba(26, 26, 46, 0.6); backdrop-filter: blur(20px); border: 1px solid rgba(168, 85, 247, 0.12); }

.glass-strong { background: rgba(18, 18, 31, 0.85); backdrop-filter: blur(24px); border-top: 1px solid rgba(168, 85, 247, 0.15); }

.placeholder\:text-gray-500::placeholder { --tw-text-opacity: 1; color: rgb(107 114 128 / var(--tw-text-opacity, 1)); }

.hover\:bg-white\/5:hover { background-color: rgba(255, 255, 255, 0.05); }

.focus\:border-purple-500\/50:focus { border-color: rgba(168, 85, 247, 0.5); }

.focus\:outline-none:focus { outline: transparent solid 2px; outline-offset: 2px; }

.active\:scale-90:active { --tw-scale-x: .9; --tw-scale-y: .9; transform: translate(var(--tw-translate-x),var(--tw-translate-y)) rotate(var(--tw-rotate)) skew(var(--tw-skew-x)) skewY(var(--tw-skew-y)) scaleX(var(--tw-scale-x)) scaleY(var(--tw-scale-y)); }

.active\:scale-\[0\.98\]:active { --tw-scale-x: .98; --tw-scale-y: .98; transform: translate(var(--tw-translate-x),var(--tw-translate-y)) rotate(var(--tw-rotate)) skew(var(--tw-skew-x)) skewY(var(--tw-skew-y)) scaleX(var(--tw-scale-x)) scaleY(var(--tw-scale-y)); }

.active\:bg-white\/5:active { background-color: rgba(255, 255, 255, 0.05); }

.group:hover .group-hover\:scale-105 { --tw-scale-x: 1.05; --tw-scale-y: 1.05; transform: translate(var(--tw-translate-x),var(--tw-translate-y)) rotate(var(--tw-rotate)) skew(var(--tw-skew-x)) skewY(var(--tw-skew-y)) scaleX(var(--tw-scale-x)) scaleY(var(--tw-scale-y)); }

.group:hover .group-hover\:border-purple-400\/60 { border-color: rgba(192, 132, 252, 0.6); }

.group:hover .group-hover\:bg-purple-500\/10 { background-color: rgba(168, 85, 247, 0.1); }

.group:hover .group-hover\:opacity-100 { opacity: 1; }
