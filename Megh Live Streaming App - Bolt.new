._surface_1ublg_6 { background: rgba(16, 20, 28, 0.55); backdrop-filter: blur(10px) saturate(120%); box-shadow: rgba(255, 255, 255, 0.05) 0px 1px inset; border: 1px solid rgba(150, 190, 255, 0.16); transition: background 0.2s, border-color 0.2s; }

._surface_1ublg_6:hover { border-color: rgba(83, 196, 255, 0.42); background: rgba(43, 166, 255, 0.16); }

._surfaceSelected_1ublg_19 { background: rgba(16, 20, 28, 0.55); backdrop-filter: blur(10px) saturate(120%); border: 1px solid rgb(var(--bolt-ds-brand)); box-shadow: inset 0 1px #ffffff14,inset 0 0 20px rgb(var(--bolt-ds-brand)/.18),0 0 0 1px rgb(var(--bolt-ds-brand)/.5),0 0 24px rgb(var(--bolt-ds-brand)/.45),0 10px 24px #060a1480; }

[data-theme="light"] ._surface_1ublg_6 { background: rgba(255, 255, 255, 0.55); backdrop-filter: blur(10px) saturate(120%); box-shadow: rgba(255, 255, 255, 0.7) 0px 1px inset, rgba(15, 23, 42, 0.04) 0px 1px 2px; border: 1px solid rgba(15, 23, 42, 0.08); }

[data-theme="light"] ._surface_1ublg_6:hover { border-color: rgba(15, 23, 42, 0.14); background: rgba(255, 255, 255, 0.78); box-shadow: rgba(255, 255, 255, 0.9) 0px 1px inset, rgba(15, 23, 42, 0.06) 0px 2px 8px; }

[data-theme="light"] ._surfaceSelected_1ublg_19 { background: rgba(255, 255, 255, 0.55); backdrop-filter: blur(10px) saturate(120%); border: 1px solid rgb(var(--bolt-ds-brand)); box-shadow: inset 0 1px #fffc,inset 0 0 20px rgb(var(--bolt-ds-brand)/.12),0 0 0 1px rgb(var(--bolt-ds-brand)/.35),0 0 20px rgb(var(--bolt-ds-brand)/.2),0 8px 20px #0f172a14; }

