:root { --bolt-font-monospace: ui-monospace, "Fira Code", Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; --chat-padding: .5rem; --header-height: 50px; --panel-header-height: 50px; --side-menu-width: 35px; --dashboard-sidebar-width: 300px; --dashboard-sidebar-collapsed-width: 64px; --account-selector-width: 282px; --chat-default-width: 450px; --chat-min-width: var(--chat-default-width); --chat-only-max-width: clamp(720px, 50vw, 1024px); --chat-width: var(--chat-default-width); --dashboard-content-max-width: 1428px; --chat-max-width: var(--chat-min-width); --workbench-width: calc(100% - var(--chat-min-width)); --workbench-inner-width: calc(var(--workbench-width) - 1rem); --workbench-left: calc(100% - var(--workbench-width)); --toastify-color-progress-success: rgb(var(--bolt-ds-success)); --toastify-color-progress-error: rgb(var(--bolt-ds-danger)); }

@media (min-width: 640px) {
  :root { --chat-padding: 1rem; }
}

:root:has([data-mobile-header-v2]) { --header-height: 60px; }

@media (min-width: 1024px) {
  :root { --chat-min-width: clamp(375px, var(--chat-width), calc(100vw - 400px) ); }
}

@property --gradient-end { syntax: "<color>"; inherits: false; initial-value: transparent; }

.z-logo { z-index: 998; }

.z-sidebar, .z-resources { z-index: 997; }

.z-port-dropdown, .z-preview-controls-dropdown, .z-visibility-dropdown { z-index: 999; }

.z-iframe-overlay { z-index: 995; }

.z-prompt, .z-scroller { z-index: 2; }

.z-workbench { z-index: 3; }

.z-command-popup { z-index: 9; }

.z-version-history-drawer { z-index: 997; }

.z-version-history-preview-bar, .z-context-menu, .z-loading, .z-fullscreen { z-index: 998; }

.z-dialog { z-index: 999; }

.z-file-tree-breadcrumb { z-index: 998; }

.z-max { z-index: 999; }

z-layer-0 { z-index: 0; }

.z-layer-1 { z-index: 1; }

.z-layer-2 { z-index: 2; }

.z-layer-3 { z-index: 3; }

:root { --shimmer-color: rgba(255, 255, 255, .8); --loading-bar-background: linear-gradient(90deg, #f5f5f5 0%, #2ba6ff 21.5%, #fff 33%, #2ba6ff 65.5%, #f5f5f5 100%); }

:root[data-theme="dark"] { --shimmer-color: rgba(255, 255, 255, .06); --loading-bar-background: linear-gradient(90deg, #0a0a0a 0%, #2ba6ff 21.5%, #fff 33%, #2ba6ff 65.5%, #0a0a0a 100%); }

.animated { animation-fill-mode: both; animation-duration: var(--animate-duration, .2s); animation-timing-function: cubic-bezier(0, 0, 0.2, 1); }

.animated.fadeInRight { animation-name: fadeInRight; }

.animated.fadeOutRight { animation-name: fadeOutRight; }

.animated.fadeIn { animation-name: fadeIn; }

@keyframes fadeIn { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes followUpPromptEnter { 
  0% { opacity: 0; transform: translateY(8px); filter: blur(2px); }
  100% { opacity: 1; transform: translateY(0px); filter: blur(0px); }
}

@media (prefers-reduced-motion: no-preference) {
  .follow-up-prompt-enter { animation: 0.36s cubic-bezier(0.22, 1, 0.36, 1) 0s 1 normal backwards running followUpPromptEnter; }
}

@keyframes fadeInRight { 
  0% { opacity: 0; transform: translate3d(100%, 0px, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

@keyframes dsSourceEnter { 
  0% { opacity: 0; transform: translate3d(-40px, 0px, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

@keyframes dsSourceExit { 
  0% { opacity: 1; transform: translateZ(0px); }
  100% { opacity: 0; transform: translate3d(-40px, 0px, 0px); }
}

.ds-source-enter { animation: 0.18s cubic-bezier(0.16, 1, 0.3, 1) 0s 1 normal both running dsSourceEnter; }

.ds-source-exit { animation: 0.12s cubic-bezier(0.4, 0, 1, 1) 0s 1 normal both running dsSourceExit; }

@keyframes fadeOutRight { 
  0% { opacity: 1; }
  100% { opacity: 0; transform: translate3d(100%, 0px, 0px); }
}

.dropdown-animation { opacity: 0; animation: 0.15s cubic-bezier(0.4, 0, 0.2, 1) 0s 1 normal forwards running fadeMoveDown; }

@keyframes fadeMoveDown { 
  100% { opacity: 1; transform: translateY(6px); }
}

.shimmer { position: relative; overflow: hidden; }

.shimmer::before { content: ""; position: absolute; top: 0px; left: 0px; width: 100%; height: 100%; background: linear-gradient(90deg,transparent 30%,var(--shimmer-color) 50%,transparent 70%); transform: skew(45deg) translate(-100%); animation: 3s ease 0s infinite normal none running shimmer; }

@keyframes shimmer { 
  0% { transform: skew(45deg) translate(-150%); }
  100% { transform: skew(45deg) translate(150%); }
}

.shimmer-icon { display: inline-block; --base-gradient-color: rgb(var(--bolt-ds-textPrimary)); --base-color: rgb(var(--bolt-ds-textTertiary)); --spread: 20%; background-image: linear-gradient(90deg,rgba(0,0,0,0) calc(50% - var(--spread)),var(--base-gradient-color) 50%,rgba(0,0,0,0) calc(50% + var(--spread))),linear-gradient(var(--base-color),var(--base-color)); background-size: 400% 100%, auto; background-repeat: no-repeat; background-position: 100% 0px, 0px 0px; animation-duration: ; animation-timing-function: ; animation-iteration-count: ; animation-direction: ; animation-fill-mode: ; animation-play-state: ; animation-name: ; animation-timeline: ; animation-range-start: ; animation-range-end: ; animation-delay: var(--shimmer-delay, 0s); }

:root[data-theme="dark"] .shimmer-icon { --base-color: rgb(var(--bolt-ds-textSecondary)); --base-gradient-color: rgb(var(--bolt-ds-textPrimary)); }

@keyframes shimmerIcon { 
  0% { background-position: 100% 0px, 0px 0px; }
  100% { background-position: 0% 0px, 0px 0px; }
}

.bolt-text-shimmer { animation: textShimmer var(--shimmer-duration, 1.5s) linear infinite; }

@media (prefers-reduced-motion: reduce) {
  .bolt-text-shimmer { animation: auto ease 0s 1 normal none running none; }
}

@keyframes textShimmer { 
  0% { background-position: 100% center, 0px 0px; }
  100% { background-position: 0% center, 0px 0px; }
}

.loadingBar { width: 57%; height: 100%; background: var(--loading-bar-background); position: absolute; left: 0px; animation: 4s linear 0s infinite normal none running loadingBar; }

@keyframes loadingBar { 
  0% { transform: translate(-100%); }
  100% { transform: translate(200%); }
}

.grid-background { background-image: linear-gradient(45deg, rgb(229, 229, 229) 25%, transparent 25%, transparent 75%, rgb(229, 229, 229) 75%, rgb(229, 229, 229)), linear-gradient(45deg, rgb(229, 229, 229) 25%, transparent 25%, transparent 75%, rgb(229, 229, 229) 75%, rgb(229, 229, 229)); background-size: 20px 20px; background-position: 0px 0px, 10px 10px; }

:root[data-theme="dark"] .grid-background, .dark .grid-background { background-image: linear-gradient(45deg, rgb(26, 26, 26) 25%, transparent 25%, transparent 75%, rgb(26, 26, 26) 75%, rgb(26, 26, 26)), linear-gradient(45deg, rgb(26, 26, 26) 25%, transparent 25%, transparent 75%, rgb(26, 26, 26) 75%, rgb(26, 26, 26)); background-size: 20px 20px; background-position: 0px 0px, 10px 10px; }

.shimmer-image-overlay { overflow: hidden; }

.shimmer-image-overlay::before { content: ""; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%; background: linear-gradient(135deg, transparent 30%, rgba(255, 255, 255, 0.3) 40%, rgba(255, 255, 255, 0.5) 50%, rgba(255, 255, 255, 0.3) 60%, transparent 70%); animation: 2s ease-in-out 0s infinite normal none running shimmerImageDiagonal; pointer-events: none; z-index: 0; }

.shimmer-image-overlay > * { position: relative; z-index: 1; }

:root[data-theme="dark"] .shimmer-image-overlay::before { background: linear-gradient(135deg, transparent 30%, rgba(255, 255, 255, 0.1) 40%, rgba(255, 255, 255, 0.15) 50%, rgba(255, 255, 255, 0.1) 60%, transparent 70%); }

@keyframes shimmerImageDiagonal { 
  0% { transform: translate(-50%, -50%) translate(-100%) translateY(-100%); }
  100% { transform: translate(-50%, -50%) translate(100%) translateY(100%); }
}

.shimmer-text { --shimmer-text-base: rgb(var(--bolt-ds-textTertiary, 136 136 136)); --shimmer-text-highlight: rgb(var(--bolt-ds-textPrimary)); background-image: ; background-position-x: ; background-position-y: ; background-repeat: ; background-attachment: ; background-origin: ; background-color: ; background-size: 200% 100%; background-clip: text; -webkit-text-fill-color: transparent; animation: 2.5s ease-in-out 0s infinite normal none running shimmerText; }

@keyframes shimmerText { 
  0% { background-position: 100% 0px; }
  100% { background-position: -100% 0px; }
}

.xterm { padding: 1rem; height: 100%; }

.xterm .xterm-viewport { overflow-y: auto !important; }

[data-resize-handle] { position: relative; }

[data-resize-handle][data-panel-group-direction="horizontal"]::after, [data-resize-handle][data-panel-group-direction="vertical"]::after { content: ""; position: absolute; z-index: 999; }

[data-resize-handle][data-panel-group-direction="horizontal"]::after { inset: 0px -5px 0px -6px; }

[data-resize-handle][data-panel-group-direction="vertical"]::after { inset: -5px 0px -6px; }

[data-resize-handle]:focus::after, [data-resize-handle][data-resize-handle-state="hover"]::after, [data-resize-handle][data-resize-handle-state="drag"]::after { background-color: var(--bolt-ds-borderPrimary); }

[data-chat-resize-handle]::after { content: ""; position: absolute; inset: 0px -4px 16px; z-index: 999; }

[data-chat-resize-handle]:focus-visible::after { background-color: var(--bolt-ds-borderPrimary); border: 1px solid var(--bolt-ds-borderPrimary); }

.actions .shiki, .pinned-message .shiki { background-color: var(--bolt-ds-neutralBgSubtle) !important; }

.shiki:not(:has(.actions, .pinned-message), .actions *, .pinned-message *) { background-color: var(--bolt-ds-neutralBgSubtle) !important; }

:root { --cm-backgroundColor: rgb(var(--bolt-ds-bgAlt)); --cm-textColor: rgb(var(--bolt-ds-textPrimary)); --cm-gutter-backgroundColor: var(--cm-backgroundColor); --cm-gutter-textColor: rgb(var(--bolt-ds-textSecondary)); --cm-gutter-activeLineTextColor: var(--cm-gutter-textColor); --cm-foldGutter-textColor: var(--cm-gutter-textColor); --cm-foldGutter-textColorHover: var(--cm-gutter-textColor); --cm-activeLineBackgroundColor: var(--bolt-ds-utilHover); --cm-cursor-width: 2px; --cm-cursor-backgroundColor: rgb(var(--bolt-ds-textSecondary)); --cm-matching-bracket: rgb(var(--bolt-ds-brand) / .3); --cm-selection-backgroundColorFocused: rgb(var(--bolt-ds-brand)); --cm-selection-backgroundOpacityFocused: .3; --cm-selection-backgroundColorBlured: rgb(var(--bolt-ds-brand)); --cm-selection-backgroundOpacityBlured: .3; --cm-panels-borderColor: var(--bolt-ds-borderPrimary); --cm-search-backgroundColor: var(--cm-backgroundColor); --cm-search-textColor: rgb(var(--bolt-ds-textSecondary)); --cm-search-closeButton-backgroundColor: transparent; --cm-search-closeButton-backgroundColorHover: var(--bolt-ds-utilHover); --cm-search-closeButton-textColor: rgb(var(--bolt-ds-neutralHover)); --cm-search-closeButton-textColorHover: rgb(var(--bolt-ds-inverseBg)); --cm-search-button-backgroundColor: rgb(var(--bolt-ds-bgSecondary)); --cm-search-button-backgroundColorHover: var(--bolt-ds-utilHover); --cm-search-button-textColor: rgb(var(--bolt-ds-textSecondary)); --cm-search-button-textColorHover: rgb(var(--bolt-ds-textPrimary)); --cm-search-button-borderColor: transparent; --cm-search-button-borderColorHover: transparent; --cm-search-button-borderColorFocused: var(--bolt-ds-brandBorderSubtle); --cm-search-input-backgroundColor: transparent; --cm-search-input-textColor: rgb(var(--bolt-ds-textPrimary)); --cm-search-input-borderColor: var(--bolt-ds-borderPrimary); --cm-search-input-borderColorFocused: var(--bolt-ds-brandBorderSubtle); --cm-tooltip-backgroundColor: var(--cm-backgroundColor); --cm-tooltip-textColor: rgb(var(--bolt-ds-textPrimary)); --cm-tooltip-backgroundColorSelected: var(--bolt-ds-brandBgSubtleHover); --cm-tooltip-textColorSelected: rgb(var(--bolt-ds-textPrimary)); --cm-tooltip-borderColor: var(--bolt-ds-borderPrimary); --cm-searchMatch-backgroundColor: rgb(var(--bolt-ds-warning) / .33); }

html[data-theme="light"] { --cm-gutter-textColor: rgb(var(--bolt-ds-textTertiary)); --cm-gutter-activeLineTextColor: rgb(var(--bolt-ds-textPrimary)); --cm-foldGutter-textColorHover: rgb(var(--bolt-ds-textPrimary)); --cm-search-button-backgroundColor: rgb(var(--bolt-ds-bgTertiaryAlt)); --cm-search-button-backgroundColorHover: var(--bolt-ds-utilHover); }

html[data-theme="dark"] { --cm-backgroundColor: rgb(var(--bolt-ds-bgAlt)); --cm-gutter-textColor: rgb(var(--bolt-ds-textTertiary)); --cm-gutter-activeLineTextColor: rgb(var(--bolt-ds-textSecondary)); --cm-foldGutter-textColorHover: rgb(var(--bolt-ds-textPrimary)); --cm-search-button-backgroundColor: rgb(var(--bolt-ds-bgSecondary)); --cm-search-button-backgroundColorHover: var(--bolt-ds-utilHover); }

.cm-tooltip.cm-ai-tooltip { border-radius: calc(var(--radius) - 2px); --un-shadow: var(--un-shadow-inset) 0 1px 2px 0 var(--un-shadow-color, rgb(0 0 0 / .05)); box-shadow: var(--un-ring-offset-shadow),var(--un-ring-shadow),var(--un-shadow); border: 0px; overflow: hidden; }

.cm-tooltip.cm-ai-tooltip button { --un-bg-opacity: 1; background-color: rgb(20 136 252 / var(--un-bg-opacity)); --un-text-opacity: 1; color: rgb(255 255 255 / var(--un-text-opacity)); }

.cm-tooltip.cm-ai-tooltip button:hover, [data-theme="dark"] .cm-tooltip.cm-ai-tooltip button { --un-bg-opacity: 1; background-color: rgb(13 111 232 / var(--un-bg-opacity)); }

[data-theme="dark"] .cm-tooltip.cm-ai-tooltip button:hover { --un-bg-opacity: 1; background-color: rgb(20 136 252 / var(--un-bg-opacity)); }

.mkt-nav-shell { position: sticky; top: 0px; z-index: 100; flex-shrink: 0; width: 100%; }

.mkt-nav-shell.is-drawer-open { height: 68px; }

.mkt-nav-shell.is-drawer-open .mkt-nav { position: fixed; top: 0px; left: 0px; right: 0px; }

.mkt-nav { position: relative; z-index: 100; width: 100%; background: rgba(5, 5, 7, 0.72); backdrop-filter: saturate(140%) blur(18px); border-bottom: 1px solid rgba(255, 255, 255, 0.14); }

.mkt-nav--on-light { background: rgb(5, 5, 7); }

.mkt-nav-inner { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 24px; height: 68px; width: min(1200px, -160px + 100vw); margin: 0px auto; padding: 0px; position: relative; }

@media (max-width: 1024px) {
  .mkt-nav-inner { width: min(900px, -80px + 100vw); grid-template-columns: auto 1fr; }
  .mkt-nav-right { grid-column: 2; }
}

@media (max-width: 768px) {
  .mkt-nav-inner { width: calc(-32px + 100vw); }
}

.mkt-nav-logo { display: inline-flex; align-items: center; color: rgb(255, 255, 255); text-decoration: none; flex-shrink: 0; transition: opacity 0.15s; }

.mkt-nav-logo:hover { opacity: 0.85; }

.mkt-nav-logo svg { height: 20px; width: auto; display: block; }

@media (max-width: 1024px) {
  .mkt-nav-logo svg { height: 24px; }
}

.mkt-nav-logo { grid-column: 1; justify-self: start; }

.mkt-nav-list, .mkt-nav-items { grid-column: 2; }

.mkt-nav-logo, .mkt-nav-back { transition: opacity 0.22s ease-out, transform 0.24s cubic-bezier(0.22, 1, 0.36, 1); transform-origin: left center; }

.mkt-nav-back { display: inline-flex; align-items: center; gap: 8px; background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 8px 0px; color: rgb(255, 255, 255); font-family: Silkscreen, monospace; font-size: 12px; font-weight: 400; letter-spacing: 2px; text-transform: uppercase; cursor: pointer; position: absolute; left: 0px; opacity: 0; transform: translateY(12px); pointer-events: none; }

.mkt-nav-back-icon { width: 16px; height: 16px; transform: translateY(0.75px); }

.mkt-nav-logo { position: relative; }

.mkt-nav.is-on-submenu .mkt-nav-logo { opacity: 0; transform: translateY(-12px); pointer-events: none; }

.mkt-nav.is-on-submenu .mkt-nav-back { opacity: 1; transform: translateY(0px); pointer-events: auto; }

@media (min-width: 1025px) {
  .mkt-nav-back { display: none; }
}

.mkt-nav-items { display: flex; align-items: center; gap: 4px; list-style: none; margin: 0px; padding: 0px; justify-content: center; }

.mkt-nav-items li { margin: 0px; height: 68px; display: flex; align-items: center; }

.mkt-nav-items .mkt-nav-link { height: 100%; }

.mkt-nav-link { display: inline-flex; align-items: center; gap: 4px; padding: 8px 14px; font-family: Inter, sans-serif; font-size: 14px; font-weight: 500; color: rgba(255, 255, 255, 0.75); background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 4px; cursor: pointer; text-decoration: none; transition: color 0.15s, background 0.15s; }

.mkt-nav-link:hover { color: rgb(255, 255, 255); background: rgba(255, 255, 255, 0.05); }

.mkt-nav-link.is-active { color: rgb(255, 255, 255); }

.mkt-nav-link { position: relative; }

.mkt-nav-link .mkt-nav-chev { width: 12px; height: 12px; transition: transform 0.2s; }

.mkt-nav-link.is-open .mkt-nav-chev, .mkt-nav-link[data-state="open"] .mkt-nav-chev { transform: rotate(180deg); }

.mkt-nav-link.is-open, .mkt-nav-link[data-state="open"] { color: rgb(255, 255, 255); background: rgba(255, 255, 255, 0.05); }

.mkt-nav-actions { display: flex; align-items: center; gap: 16px; flex-shrink: 0; }

.mkt-nav-signin { font-family: Inter, sans-serif; font-size: 14px; font-weight: 500; color: rgba(255, 255, 255, 0.75); text-decoration: none; transition: color 0.15s; }

.mkt-nav-signin:hover { color: rgb(255, 255, 255); }

.mkt-nav-cta.hero-btn-primary { height: 38px; padding: 0px 18px; font-size: 14px; min-width: 0px; }

.mkt-nav-cta.hero-btn-primary .btn-text-wrap { height: 1.15em; }

.mkt-nav-right { display: flex; align-items: center; gap: 12px; flex-shrink: 0; grid-column: 3; justify-self: end; }

.mkt-nav-burger { display: none; width: 40px; height: 40px; min-width: 40px; flex-shrink: 0; background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 4px; padding: 0px; cursor: pointer; position: relative; -webkit-tap-highlight-color: transparent; }

.mkt-nav-burger:hover, .mkt-nav-burger:focus, .mkt-nav-burger:active { background: none; outline: none; }

.mkt-nav-burger span { position: absolute; left: 9px; width: 22px; height: 1.5px; background: rgb(255, 255, 255); border-radius: 1px; transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1), width 0.28s, left 0.28s, opacity 0.18s; transform-origin: center center; }

.mkt-nav-burger span:nth-child(1) { top: 12px; }

.mkt-nav-burger span:nth-child(2) { top: 19px; }

.mkt-nav-burger span:nth-child(3) { top: 26px; }

.mkt-nav-burger.is-open span { left: 9px; width: 22px; }

.mkt-nav-burger.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }

.mkt-nav-burger.is-open span:nth-child(2) { opacity: 0; transform: scaleX(0.5); }

.mkt-nav-burger.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

.mkt-nav-panel-inner { display: grid; grid-template-columns: repeat(2, minmax(0px, 1fr)); gap: 24px; max-width: 1120px; margin: 0px auto; padding: 40px clamp(16px, 4vw, 80px) 48px; }

.mkt-nav-content[data-panel="platform"] .mkt-nav-panel-inner { grid-template-columns: minmax(0px, 320px); max-width: 1120px; justify-content: start; }

.mkt-nav-content[data-panel="solutions"] .mkt-nav-panel-inner, .mkt-nav-content[data-panel="resources"] .mkt-nav-panel-inner { grid-template-columns: repeat(3, minmax(0px, 1fr)); gap: 20px; }

.mkt-nav-panel-col { display: flex; flex-direction: column; gap: 0px; }

.mkt-nav-panel-feature { display: none; padding: 14px; border-radius: 6px; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); text-decoration: none; transition: border-color 0.2s, background 0.2s; }

.mkt-nav-panel-feature:hover { border-color: rgba(255, 255, 255, 0.22); background: rgba(255, 255, 255, 0.043); }

.mkt-nav-panel-feature-visual { aspect-ratio: 7 / 4; border-radius: 4px; margin-bottom: 14px; position: relative; overflow: hidden; background: linear-gradient(135deg, rgba(20, 136, 252, 0.85), rgba(127, 221, 193, 0.4)); }

.mkt-nav-content[data-panel="solutions"] .mkt-nav-panel-feature-visual { background: url("/static/marketing/nav/nav-smb.webp") center center / cover no-repeat rgb(11, 87, 201); }

.mkt-nav-content[data-panel="resources"] .mkt-nav-panel-feature-visual { background: url("/static/marketing/nav/nav-templates.webp") center center / cover no-repeat rgb(11, 87, 201); }

.mkt-nav-panel-feature-eyebrow { font-family: Silkscreen, monospace; font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255, 255, 255, 0.5); margin: 0px 0px 8px; }

.mkt-nav-panel-feature-title { display: flex; align-items: center; gap: 8px; font-family: Inter, sans-serif; font-size: 18px; font-weight: 500; color: rgb(255, 255, 255); letter-spacing: -0.2px; line-height: 1.25; margin: 0px 0px 10px; }

.mkt-nav-panel-feature-title::after { content: "‚Üí"; font-size: 15px; transition: transform 0.18s; }

.mkt-nav-panel-feature:hover .mkt-nav-panel-feature-title::after { transform: translate(4px); }

.mkt-nav-panel-feature-desc { font-size: 13px; color: rgba(255, 255, 255, 0.55); line-height: 1.55; margin: 0px; }

@media (min-width: 1025px) {
  .mkt-nav-panel-feature { display: block; }
  .mkt-nav-content[data-panel="platform"] .mkt-nav-panel-inner { grid-template-columns: 260px minmax(0px, 300px); max-width: 1120px; justify-content: start; gap: 32px 44px; }
  .mkt-nav-content[data-panel="solutions"] .mkt-nav-panel-inner, .mkt-nav-content[data-panel="resources"] .mkt-nav-panel-inner { grid-template-columns: 260px repeat(3, minmax(0px, 1fr)); gap: 32px 44px; }
}

.mkt-nav-panel-heading { font-family: Silkscreen, monospace; font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255, 255, 255, 0.4); margin: 0px 0px 16px; }

.mkt-nav-panel-col a { position: relative; display: flex; align-items: center; gap: 8px; font-family: Inter, sans-serif; font-size: 17px; font-weight: 500; color: rgba(255, 255, 255, 0.85); text-decoration: none; line-height: 1.4; padding: 10px 0px; transition: color 0.18s, opacity 0.18s, transform 0.18s; }

.mkt-nav-panel-col a::after { content: "‚Üí"; font-family: Inter, sans-serif; color: currentcolor; opacity: 0; transform: translate(-4px); transition: opacity 0.18s, transform 0.18s; }

.mkt-nav-panel-col a:hover { color: rgb(255, 255, 255); }

.mkt-nav-panel-col a:hover::after { opacity: 1; transform: translate(0px); }

.mkt-nav-content:has(.mkt-nav-panel-col a:hover) .mkt-nav-panel-col a { opacity: 0.32; }

.mkt-nav-content:has(.mkt-nav-panel-col a:hover) .mkt-nav-panel-col a:hover { opacity: 1; }

.mkt-nav-scrim { position: fixed; inset: 68px 0px 0px; background: rgba(0, 0, 0, 0.5); opacity: 0; pointer-events: none; transition: opacity 0.18s; z-index: 99; }

.mkt-nav-scrim.is-open { opacity: 1; pointer-events: auto; }

@media (max-width: 1024px) {
  .mkt-nav-list, .mkt-nav-items { display: none; }
  .mkt-nav-burger { display: inline-flex; }
  .mkt-nav-viewport-wrap { display: none !important; }
}

@media (max-width: 400px) {
  .mkt-nav-signin { display: none; }
}

.mkt-nav-mobile { position: fixed; top: 68px; left: 0px; right: 0px; height: calc(100dvh - 68px); z-index: 90; background: rgba(10, 10, 16, 0.98); backdrop-filter: blur(24px); display: flex; flex-direction: column; opacity: 0; transition: opacity 0.28s, visibility linear 0.28s; visibility: hidden; }

.mkt-nav-mobile.is-open { opacity: 1; visibility: visible; transition: opacity 0.28s, visibility; }

.mkt-nav-mobile-header { display: none; }

.mkt-nav-mobile-close, .mkt-nav-mobile-back { background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; color: rgb(255, 255, 255); font-family: Inter, sans-serif; font-size: 14px; font-weight: 500; display: inline-flex; align-items: center; gap: 6px; cursor: pointer; padding: 8px; }

.mkt-nav-close-icon { width: 20px; height: 20px; }

.mkt-nav-mobile-body { flex: 1 1 0%; position: relative; overflow: hidden; }

.mkt-nav-mobile-view { position: absolute; inset: 0px; overflow-y: auto; padding: 28px clamp(16px, 4vw, 40px); opacity: 0; transform: translate(-24px); transition: opacity 0.28s, transform 0.32s cubic-bezier(0.22, 1, 0.36, 1); pointer-events: none; }

.mkt-nav-mobile-view.is-active { opacity: 1; transform: translate(0px); pointer-events: auto; }

.mkt-nav-mobile-item { display: flex; align-items: center; justify-content: space-between; width: 100%; padding: 14px 0px; font-family: Inter, sans-serif; font-size: 20px; font-weight: 500; color: rgb(255, 255, 255); background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; text-align: left; text-decoration: none; cursor: pointer; }

.mkt-nav-mobile-chev { width: 16px; height: 16px; color: rgba(255, 255, 255, 0.4); }

.mkt-nav-mobile-heading { font-family: Silkscreen, monospace; font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255, 255, 255, 0.45); margin: 20px 0px 4px; }

.mkt-nav-mobile-links { display: flex; flex-direction: column; margin: 4px 0px 12px; }

.mkt-nav-mobile-links a { display: inline-flex; align-items: center; gap: 8px; align-self: flex-start; padding: 10px 0px; font-family: Inter, sans-serif; font-size: 18px; font-weight: 500; color: rgb(255, 255, 255); text-decoration: none; transition: opacity 0.18s, color 0.18s; }

.mkt-nav-mobile-links a::after { content: "‚Üí"; color: currentcolor; opacity: 0; transform: translate(-4px); transition: opacity 0.18s, transform 0.18s; }

.mkt-nav-mobile-links a:hover::after { opacity: 1; transform: translate(0px); }

.mkt-nav-mobile-view:has(.mkt-nav-mobile-links a:hover) .mkt-nav-mobile-links a, .mkt-nav-mobile-view:has(.mkt-nav-mobile-links a:hover) .mkt-nav-mobile-feature { opacity: 0.32; transition: opacity 0.18s; }

.mkt-nav-mobile-view:has(.mkt-nav-mobile-links a:hover) .mkt-nav-mobile-links a:hover { opacity: 1; }

.mkt-nav-mobile-feature { transition: opacity 0.18s; }

.mkt-nav-mobile-feature { display: block; padding: 4px 0px 16px; text-decoration: none; border-bottom: 1px solid rgba(255, 255, 255, 0.06); margin-bottom: 8px; }

.mkt-nav-mobile-feature-title { font-family: Inter, sans-serif; font-size: 22px; font-weight: 500; color: rgb(255, 255, 255); letter-spacing: -0.2px; margin: 0px 0px 6px; display: inline-flex; align-items: center; gap: 8px; }

.mkt-nav-mobile-feature-desc { font-size: 14px; color: rgba(255, 255, 255, 0.55); line-height: 1.5; margin: 0px; }

.mkt-nav-mobile-footer { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px clamp(16px, 4vw, 40px); border-top: 1px solid rgba(255, 255, 255, 0.06); flex-shrink: 0; }

.mkt-nav-mobile-footer .hero-btn-primary { height: 44px; padding: 0px 22px; font-size: 14px; border-radius: 2px; min-width: 0px; }

.mkt-nav-mobile-footer .mkt-nav-mobile-signin { color: rgba(255, 255, 255, 0.75); font-family: Inter, sans-serif; font-size: 14px; text-decoration: none; padding: 0px 8px; flex-shrink: 0; }

@media (min-width: 1025px) {
  .mkt-nav-mobile { display: none; }
}

html:has(body.mkt-nav-mobile-open), body.mkt-nav-mobile-open { overflow: hidden; }

.mkt-nav-scroll-lock { overflow: hidden !important; }

.site-footer { background: rgb(0, 0, 0); width: 100%; box-sizing: border-box; padding: 92px min(80px, 5vw) 40px; text-align: left; }

.site-footer--on-app { background: rgb(var(--bolt-ds-bg)); border-top: 1px solid var(--bolt-ds-borderSecondary); }

.site-footer--on-app .site-footer-label { color: rgb(var(--bolt-ds-textTertiary)); }

.site-footer--on-app .site-footer-links a { color: rgb(var(--bolt-ds-textSecondary)); }

.site-footer--on-app .site-footer-links a:hover { color: rgb(var(--bolt-ds-textPrimary)); }

.site-footer--on-app .site-footer-social a { background: var(--bolt-ds-utilHover); color: rgb(var(--bolt-ds-textSecondary)); }

.site-footer--on-app .site-footer-social a:hover { background: rgb(var(--bolt-ds-bgAltHover)); color: rgb(var(--bolt-ds-textPrimary)); }

.site-footer-cols { width: 100%; max-width: 1200px; margin: 0px auto; display: flex; flex-wrap: wrap; gap: 40px 24px; }

.site-footer-col { display: flex; flex-direction: column; gap: 0px; flex: 1 1 0%; }

.site-footer-label { font-family: Silkscreen, monospace; font-size: 11px; font-weight: 400; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255, 255, 255, 0.4); margin: 0px 0px 16px; }

.site-footer-links { list-style: none; margin: 0px; padding: 0px; display: flex; flex-direction: column; gap: 0px; }

.site-footer-links a { position: relative; display: inline-flex; align-items: center; gap: 6px; align-self: flex-start; padding: 10px 0px; font-size: 16px; color: rgba(255, 255, 255, 0.7); text-decoration: none; transition: color 0.18s, opacity 0.18s; }

.site-footer-links a::after { content: "‚Üí"; color: currentcolor; opacity: 0; transform: translate(-4px); transition: opacity 0.18s, transform 0.18s; }

.site-footer-links a:hover { color: rgb(255, 255, 255); }

.site-footer-links a:hover::after { opacity: 1; transform: translate(0px); }

.site-footer-cols:has(a:hover) a { opacity: 0.5; }

.site-footer-cols:has(a:hover) a:hover { opacity: 1; }

.site-footer-col--connect { flex: 0 0 auto; min-width: 0px; }

.site-footer-social { display: flex; gap: 10px; margin-top: 6px; }

.site-footer-social--col { flex-direction: column; align-items: flex-start; gap: 12px; margin-top: 0px; }

.site-footer-social a { width: 30px; height: 30px; border-radius: 50%; background: rgba(255, 255, 255, 0.06); display: inline-flex; align-items: center; justify-content: center; color: rgba(255, 255, 255, 0.7); transition: background 0.2s, color 0.2s; }

.site-footer-social a:hover { background: rgba(255, 255, 255, 0.12); color: rgb(255, 255, 255); }

.site-footer-social-icon { width: 14px; height: 14px; }

.site-footer-tail { background: rgb(0, 0, 0); padding: 0px min(80px, 5vw) 40px; }

.site-footer-divider { width: 100%; max-width: 1200px; margin: 0px auto; border-top: 1px solid rgba(255, 255, 255, 0.2); }

.site-footer-bottom { width: 100%; max-width: 1200px; margin: 0px auto; padding-top: 24px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; }

.site-footer-logo { height: 22px; width: auto; display: block; }

.site-footer-logo svg { height: 100%; width: auto; display: block; }

.site-footer-legal { display: flex; align-items: center; flex-wrap: wrap; gap: 18px 20px; }

.site-footer-legal a { font-size: 12px; color: rgba(255, 255, 255, 0.4); text-decoration: none; transition: color 0.2s; }

.site-footer-legal a:hover { color: rgba(255, 255, 255, 0.8); }

.site-footer-copyright { font-size: 12px; color: rgba(255, 255, 255, 0.35); }

@media (max-width: 768px) {
  .site-footer { padding: 56px 20px 32px; }
  .site-footer-cols { gap: 32px 20px; }
  .site-footer-col { min-width: calc(50% - 10px); flex: 0 0 calc(50% - 10px); }
  .site-footer-links a { font-size: 17px; padding: 8px 0px; }
  .site-footer-tail { padding: 0px 20px 32px; }
  .site-footer-bottom { flex-flow: wrap; align-items: center; gap: 12px 20px; }
  .site-footer-logo { height: 18px; }
  .site-footer-legal { flex: 1 1 0%; min-width: 0px; gap: 12px 16px; }
  .site-footer-legal a { font-size: 12px; }
  .site-footer-copyright { flex: 0 0 100%; order: 2; margin-top: 4px; }
}

.hero-btn-group .hero-btn-primary, .hero-btn-group .hero-btn-ghost, .hero-cta-row .hero-btn-primary, .hero-cta-row .hero-btn-ghost, .builtin-cta .hero-btn-primary, .builtin-cta .hero-btn-ghost, .run-callout-btns .hero-btn-primary, .run-callout-btns .hero-btn-ghost, .footer-cta-btn { min-width: var(--cta-min-w); max-width: 100%; }

:is(form, .hero-form-row, .card-form-strip, .re-prompt-shell) :is(.hero-btn-primary, .hero-btn-ghost, .footer-cta-btn), .hero-cta-button, .re-prompt-submit { min-width: 0px; max-width: none; }

.hero-btn-primary { display: inline-flex; align-items: center; justify-content: center; height: 52px; padding: 0px 28px; background: rgb(20, 136, 252); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 2px; color: rgb(255, 255, 255); font-size: 15px; font-weight: 600; font-family: Inter, sans-serif; cursor: pointer; position: relative; overflow: hidden; text-decoration: none; }

.hero-btn-primary .btn-bg-hover { position: absolute; inset: 0px; background: rgb(15, 111, 208); z-index: 1; transform: translateY(101%); transition: transform 0.45s cubic-bezier(0.165, 0.84, 0.44, 1); }

.hero-btn-primary .btn-text-wrap { position: relative; z-index: 3; overflow: hidden; height: 1.2em; }

.hero-btn-primary .btn-text-inner { display: flex; flex-direction: column; transition: transform 0.45s cubic-bezier(0.165, 0.84, 0.44, 1); }

.hero-btn-primary .btn-text-inner span { display: block; line-height: 1.2; }

.hero-btn-primary:hover .btn-bg-hover { transform: translateY(0px); }

.hero-btn-primary:hover .btn-text-inner { transform: translateY(-50%); }

.hero-btn-ghost .btn-bg-hover { display: none; }

.hero-btn-ghost .btn-text-wrap { position: relative; z-index: 3; overflow: hidden; height: 1.2em; }

.hero-btn-ghost .btn-text-inner { display: flex; flex-direction: column; transition: transform 0.45s cubic-bezier(0.165, 0.84, 0.44, 1); }

.hero-btn-ghost .btn-text-inner span { display: block; line-height: 1.2; }

.hero-btn-ghost:hover .btn-text-inner { transform: translateY(-50%); }

.btn-pixel-canvas { position: absolute; inset: 0px; pointer-events: none; z-index: 2; }

.hero-btn-ghost .btn-pixel-canvas { z-index: 1; border-radius: 2px; }

.hero-btn-primary.btn-pixelized .btn-bg-hover, .hero-btn-ghost.btn-pixelized .btn-bg-hover, .footer-cta-btn.btn-pixelized .btn-bg-hover { display: none !important; }

.hero-btn-primary.btn-pixelized .btn-text-inner, .hero-btn-ghost.btn-pixelized .btn-text-inner, .footer-cta-btn.btn-pixelized .btn-text-inner { transform: none !important; }

.hero-btn-primary.btn-pixelized .btn-text-inner span:nth-child(2), .hero-btn-ghost.btn-pixelized .btn-text-inner span:nth-child(2), .footer-cta-btn.btn-pixelized .btn-text-inner span:nth-child(2) { display: none; }

.hero-btn-primary.btn-pixelized .btn-text-wrap, .hero-btn-ghost.btn-pixelized .btn-text-wrap, .footer-cta-btn.btn-pixelized .btn-text-wrap { z-index: 3; }

.hero-btn-ghost { display: inline-flex; align-items: center; justify-content: center; height: 52px; padding: 0px 28px; background: transparent; border: 1px solid rgba(255, 255, 255, 0.22); border-radius: 2px; color: rgba(255, 255, 255, 0.8); font-size: 15px; font-weight: 500; font-family: Inter, sans-serif; cursor: pointer; text-decoration: none; position: relative; overflow: hidden; }

.hero-btn-ghost:hover { border-color: rgba(255, 255, 255, 0.4); color: rgb(255, 255, 255); }

.footer-image-section { width: 100%; }

.bolt-image-wrap { margin-top: 0px; width: 100%; overflow: hidden; position: relative; height: 32vw; max-height: 32vw; }

@media (max-width: 768px) {
  .bolt-image-wrap { width: 100vw; margin-left: 0px; height: 42vw; max-height: 42vw; }
}

.mkt-nav-signin, .mkt-nav-mobile-signin { background: none; border: 0px; padding: 0px; cursor: pointer; }

.mkt-nav-cta.hero-btn-primary, .mkt-nav-mobile-footer .hero-btn-primary { border: 0px; cursor: pointer; font-family: Inter, sans-serif; }

.mkt-nav-sentinel { height: 1px; margin-bottom: -1px; pointer-events: none; }

.mkt-nav-dark-sentinel { position: absolute; top: 0px; left: 0px; width: 1px; height: 1px; pointer-events: none; }

.mkt-nav { transition: background 0.2s, border-color 0.2s, backdrop-filter 0.2s; }

.mkt-nav:not(.is-scrolled):not(.has-menu-open):not(.mkt-nav--solid) { background: transparent; border-bottom-color: transparent; backdrop-filter: none; }

.mkt-nav--solid:not(.is-scrolled) { background: rgb(5, 5, 7); border-bottom-color: rgba(255, 255, 255, 0.14); }

.mkt-nav--solid.has-menu-open { background: rgb(5, 5, 7); backdrop-filter: none; }

.mkt-nav--embedded { position: static; height: 100%; flex: 1 1 0%; background: transparent; border-bottom: 0px; backdrop-filter: none; }

.mkt-nav--embedded :has(> .mkt-nav-items) { height: 100%; }

.mkt-nav--embedded .mkt-nav-items, .mkt-nav--embedded .mkt-nav-items li { height: 100%; }

@keyframes mkt-nav-viewport-in { 
  0% { opacity: 0; transform: translateY(-6px); }
  100% { opacity: 1; transform: translateY(0px); }
}

@keyframes mkt-nav-viewport-out { 
  0% { opacity: 1; transform: translateY(0px); }
  100% { opacity: 0; transform: translateY(-6px); }
}

@keyframes mkt-nav-content-in { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes mkt-nav-content-out { 
  0% { opacity: 1; }
  100% { opacity: 0; }
}

.mkt-nav-viewport-wrap { position: absolute; top: 100%; left: 0px; right: 0px; z-index: 1; display: flex; justify-content: center; }

.mkt-nav-viewport { position: relative; width: 100%; height: var(--radix-navigation-menu-viewport-height, 0px); overflow: hidden; background: rgba(8, 8, 12, 0.98); backdrop-filter: saturate(140%) blur(24px); border-bottom: 1px solid rgba(255, 255, 255, 0.08); box-shadow: rgba(0, 0, 0, 0.55) 0px 24px 60px; transform-origin: center top; transition: height 0.22s; }

.mkt-nav-viewport[data-state="open"] { animation: 0.18s ease 0s 1 normal none running mkt-nav-viewport-in; }

.mkt-nav-viewport[data-state="closed"] { animation: 0.18s ease 0s 1 normal none running mkt-nav-viewport-out; }

.mkt-nav-content { position: absolute; top: 0px; left: 0px; width: 100%; }

.mkt-nav-content[data-motion^="from"] { animation: 0.18s ease 0s 1 normal none running mkt-nav-content-in; }

.mkt-nav-content[data-motion^="to"] { animation: 0.18s ease 0s 1 normal none running mkt-nav-content-out; }

.mkt-nav--embedded .mkt-nav-viewport-wrap { left: 50%; right: auto; width: max-content; max-width: calc(-32px + 100vw); transform: translate(-50%); padding-top: 4px; }

.mkt-nav--embedded .mkt-nav-viewport { width: var(--radix-navigation-menu-viewport-width); max-width: calc(-32px + 100vw); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; transition: width 0.22s, height 0.22s; }

.mkt-nav--embedded .mkt-nav-content { width: max-content; }

.mkt-nav--embedded .mkt-nav-content[data-panel] .mkt-nav-panel-inner { grid-template-columns: 280px repeat(2, max-content); max-width: none; padding: 28px 32px 32px; }

.mkt-nav--embedded .mkt-nav-panel-heading, .mkt-nav--embedded .mkt-nav-panel-col a { white-space: nowrap; }

.footer-image-section { background: rgb(0, 0, 0); }

.site-footer, .footer-image-section { position: relative; z-index: 1; }

.mkt-nav-mobile-view { visibility: hidden; transition: opacity 0.28s, transform 0.32s cubic-bezier(0.22, 1, 0.36, 1), visibility linear 0.32s; }

.mkt-nav-mobile-view.is-active { visibility: visible; transition: opacity 0.28s, transform 0.32s cubic-bezier(0.22, 1, 0.36, 1), visibility; }

.mkt-nav-burger::after { content: ""; position: absolute; inset: -2px; }

.mkt-nav-mobile-signin { min-height: 44px; display: inline-flex; align-items: center; }

.site-footer-social a { position: relative; }

.site-footer-social a::before { content: ""; position: absolute; inset: -7px; border-radius: 50%; }

.mkt-nav-burger:focus-visible { outline: rgba(255, 255, 255, 0.7) solid 2px; outline-offset: 2px; }

.mkt-nav { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

html[data-theme="light"] .mkt-nav--embedded .mkt-nav-link { color: rgb(var(--bolt-ds-textSecondary)); }

html[data-theme="light"] .mkt-nav--embedded .mkt-nav-link:hover, html[data-theme="light"] .mkt-nav--embedded .mkt-nav-link.is-open, html[data-theme="light"] .mkt-nav--embedded .mkt-nav-link[data-state="open"] { color: rgb(var(--bolt-ds-textPrimary)); background: var(--bolt-ds-utilHover); }

html[data-theme="light"] .mkt-nav:not(.mkt-nav--solid):not(.mkt-nav--embedded):not(.is-over-dark) .mkt-nav-link { color: rgba(0, 0, 0, 0.7); }

html[data-theme="light"] .mkt-nav:not(.mkt-nav--solid):not(.mkt-nav--embedded):not(.is-over-dark) .mkt-nav-link:hover, html[data-theme="light"] .mkt-nav:not(.mkt-nav--solid):not(.mkt-nav--embedded):not(.is-over-dark) .mkt-nav-link.is-open, html[data-theme="light"] .mkt-nav:not(.mkt-nav--solid):not(.mkt-nav--embedded):not(.is-over-dark) .mkt-nav-link[data-state="open"] { color: rgb(0, 0, 0); background: rgba(0, 0, 0, 0.05); }

html[data-theme="light"] .mkt-nav:not(.mkt-nav--solid):not(.mkt-nav--embedded):not(.is-over-dark) .mkt-nav-signin { color: rgba(0, 0, 0, 0.7); }

html[data-theme="light"] .mkt-nav:not(.mkt-nav--solid):not(.mkt-nav--embedded):not(.is-over-dark) .mkt-nav-signin:hover { color: rgb(0, 0, 0); }

html[data-theme="light"] .mkt-nav:not(.mkt-nav--solid):not(.mkt-nav--embedded):not(.is-over-dark) .mkt-nav-logo svg path { fill: rgb(10, 10, 10); }

html[data-theme="light"] .mkt-nav:not(.mkt-nav--solid):not(.mkt-nav--embedded):not(.is-over-dark) .mkt-nav-burger span { background: rgb(10, 10, 10); }

html[data-theme="light"] .mkt-nav:not(.mkt-nav--solid):not(.mkt-nav--embedded):not(.is-over-dark) .mkt-nav-back { color: rgb(var(--bolt-ds-textPrimary)); }

