.animate-in, .data-\[state\=open\]\:animate-in[data-state="open"] { animation: 0.15s ease 0s 1 normal none running una-in; --una-enter-opacity: initial; --una-enter-scale: initial; --una-enter-rotate: initial; --una-enter-translate-x: initial; --una-enter-translate-y: initial; }

.data-\[state\=closed\]\:animate-out[data-state="closed"] { animation: 0.15s ease 0s 1 normal none running una-out; --una-exit-opacity: initial; --una-exit-scale: initial; --una-exit-rotate: initial; --una-exit-translate-x: initial; --una-exit-translate-y: initial; }

